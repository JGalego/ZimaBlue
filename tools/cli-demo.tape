# Record a real CLI run for the README. Run through `python tools/make_assets.py cli`.
Output docs/assets/cli-run.gif

Set Shell "bash"
Set Theme {"name":"ZimaBlue","black":"#08111b","red":"#ff6b6b","green":"#7ee787","yellow":"#ffb648","blue":"#0e6cb2","magenta":"#c9a7ff","cyan":"#3ddcff","white":"#dbe7f0","brightBlack":"#496273","brightRed":"#ff8b8b","brightGreen":"#a3f0a8","brightYellow":"#ffd080","brightBlue":"#54c8ea","brightMagenta":"#dfc9ff","brightCyan":"#c8f1fd","brightWhite":"#ffffff","background":"#08111b","foreground":"#dbe7f0","selectionBackground":"#0e6cb2","cursorColor":"#3ddcff"}
Set FontSize 19
Set Width 1200
Set Height 600
Set Padding 24
Set BorderRadius 12
Set WindowBar Colorful
Set TypingSpeed 22ms
Set Framerate 30
Set PlaybackSpeed 1

Type "zimablue run kidney --minutes 5 --record runs/assets/cli-demo.zbr"
Sleep 500ms
Enter
Sleep 20s
